    <string name="welcome_title">Welcome to PocketBot</string>
    <string name="welcome_text">Build your own Discord bot without coding. It runs right on this phone.</string>
    <string name="welcome_point_build_title">🧩 Build it</string>
    <string name="welcome_point_build">Commands, moderation, levels, tickets … pick and combine building blocks.</string>
    <string name="welcome_point_phone_title">📱 Runs on your phone</string>
    <string name="welcome_point_phone">Free and in the background until you switch it off. Big bots can move to a hoster.</string>
    <string name="welcome_point_safe_title">🔒 Safe</string>
    <string name="welcome_point_safe">Your bot token stays encrypted on this phone.</string>
    <string name="terms_title">Terms &amp; privacy</string>
    <string name="terms_text">You need a Discord account (Discord requires at least 13, in Germany usually 16 to consent to data processing). You are responsible for your bot and must follow the Discord Terms of Service and Developer Policy. PocketBot stores your Discord ID and name for the login; bot tokens stay on your phone unless you choose the encrypted cloud.</string>
