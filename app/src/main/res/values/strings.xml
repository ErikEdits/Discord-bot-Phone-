    <string name="tutorial_title">Get your bot token</string>
    <string name="tutorial_intro">Every Discord bot needs a token from the Discord Developer Portal. It takes about 2 minutes.</string>
    <string name="tutorial_step_label">Step %1$d</string>
    <string name="tutorial_step1">Open the Developer Portal (button below) and sign in with Discord.</string>
    <string name="tutorial_step2">Tap “New Application”, enter a name for your bot and accept.</string>
    <string name="tutorial_step3">Open “Bot” in the menu on the left. Optional: set a profile picture.</string>
    <string name="tutorial_step4">Tap “Reset Token”, confirm, and copy the token. Never share it with anyone!</string>
    <string name="tutorial_step5">Further down under “Privileged Gateway Intents”, turn on “Server Members Intent” and “Message Content Intent” and save.</string>
    <string name="tutorial_step6">Come back to PocketBot and paste the token.</string>
