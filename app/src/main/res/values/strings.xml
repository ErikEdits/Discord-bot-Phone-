    <string name="battery_banner_title">Allow running in the background</string>
    <string name="battery_banner_text">Android may stop your bots to save battery. Allow PocketBot to run without restrictions.</string>
    <string name="battery_banner_button">Allow</string>
    <string name="battery_tip_xiaomi">Xiaomi/Redmi/POCO: Settings → Apps → PocketBot → turn on Autostart, Battery saver → “No restrictions”. In recent apps, pull PocketBot down and tap the lock.</string>
    <string name="battery_tip_samsung">Samsung: Settings → Apps → PocketBot → Battery → “Unrestricted”. Also remove PocketBot from “Sleeping apps” under Battery → Background usage limits.</string>
    <string name="battery_tip_huawei">Huawei/Honor: Settings → Battery → App launch → PocketBot → manage manually and allow auto-launch, secondary launch and running in background.</string>
    <string name="battery_tip_oppo">OPPO/realme/OnePlus: Settings → Apps → PocketBot → Battery usage → allow background activity and auto-launch.</string>
    <string name="battery_tip_vivo">vivo/iQOO: Settings → Battery → Background power consumption → PocketBot → allow. Also enable Autostart in i Manager.</string>
    <string name="battery_tip_generic">Settings → Apps → PocketBot → Battery → “Unrestricted”.</string>
