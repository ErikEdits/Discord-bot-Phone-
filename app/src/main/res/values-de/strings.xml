    <string name="welcome_title">Willkommen bei PocketBot</string>
    <string name="welcome_text">Bau deinen eigenen Discord-Bot ohne Programmieren. Er läuft direkt auf diesem Handy.</string>
    <string name="welcome_point_build_title">🧩 Zusammenbauen</string>
    <string name="welcome_point_build">Commands, Moderation, Level, Tickets … Bausteine auswählen und kombinieren.</string>
