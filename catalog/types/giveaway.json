{
  "id": "giveaway",
  "version": 1,
  "module": "giveaway",
  "name": {
    "de": "Giveaway-Bot",
    "en": "Giveaway bot"
  },
  "description": {
    "de": "Gewinnspiele mit Mitmach-Knopf und automatischer Auslosung.",
    "en": "Giveaways with a join button and automatic draw."
  },
  "emoji": "🎉",
